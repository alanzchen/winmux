{
  "name": "winmux-promo-video",
  "version": "0.1.0",
  "private": true,
  "description": "WinMux product introduction video: code-driven motion graphics (Remotion) built on offscreen renders of WinMux's SwiftUI views, with original synthesized music and prerecorded narration.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cues": "node scripts/cues-check.mjs",
    "music": "node scripts/music/synth.mjs",
    "vo": "node scripts/vo/prepare.mjs final",
    "mix": "node scripts/mix.mjs final",
    "captions": "node scripts/captions.mjs final",
    "render:video": "remotion render src/index.ts WinMuxIntro build/video-noaudio.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --muted --gl=angle"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remotion/cli": "4.0.527",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
