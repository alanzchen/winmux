{
  "manifest_version": 3,
  "name": "WinMux Tabs for Chrome",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "description": "Reports normal-window tab changes to WinMux on this Mac. Selects only explicitly requested bound tabs.",
  "action": {
    "default_title": "WinMux Tabs"
  },
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "not_allowed"
}
